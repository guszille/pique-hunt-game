; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pique-Prop"
config/description="Pique-esconde multiplayer 3D no estilo prop-hunt."
config/version="0.5.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Language="*res://autoload/language.gd"
InputMode="*res://autoload/input_mode.gd"
Controls="*res://autoload/controls.gd"
Network="*res://autoload/network.gd"
GameState="*res://autoload/game_state.gd"
DebugTools="*res://autoload/debug_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po")
locale/fallback="pt_BR"

[rendering]

textures/vram_compression/import_etc2_astc=true
scaling_3d/scale.mobile=0.75

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="props"
3d_physics/layer_3="jogadores"
